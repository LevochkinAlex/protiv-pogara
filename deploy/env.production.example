# Скопируйте на сервер: cp deploy/env.production.example .env
# Затем отредактируйте .env и подставьте SMTP_PASS (пароль от почты).
# Файл .env не коммитится в git (см. .gitignore).

# SMTP Mail.ru — для отправки заявок с форм и чата
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=alipov@inpb.pro
SMTP_PASS=ваш-пароль-от-почты
MAIL_FROM=alipov@inpb.pro
MAIL_TO=alipov@inpb.pro
