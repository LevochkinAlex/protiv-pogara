# OpenRouter API Key для чат-бота
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
# Опционально: модель (по умолчанию meta-llama/llama-3.2-3b-instruct:free)
# OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# SMTP (Mail.ru) для отправки заявок на email
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=alipov@inpb.pro
SMTP_PASS=your-app-password
MAIL_FROM=alipov@inpb.pro
MAIL_TO=alipov@inpb.pro

# Telegram интеграция (опционально)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# URL сайта (локально: http://localhost:3000, прод: https://inpb.pro)
NEXT_PUBLIC_APP_URL=https://inpb.pro
